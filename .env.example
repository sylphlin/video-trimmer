# Google Cloud project & region for Vertex AI (Gemini calls use Vertex AI +
# Application Default Credentials -- no AI Studio API key). Authenticate once
# beforehand with: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GCP_REGION=us-central1

# GCS bucket used to stage local video for Gemini multimodal analysis (default: video-preprocessing-${PROJECT_ID})
VIDEO_TRIMMER_BUCKET=video-preprocessing-your-gcp-project-id

# Model Selection (default: gemini-3.8-flash)
MODEL_NAME=gemini-3.8-flash
